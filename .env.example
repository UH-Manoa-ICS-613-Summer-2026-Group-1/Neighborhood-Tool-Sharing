# Copy this file to a new file named '.env' 
# and fill in your secrets.

# You can use backend/secret_key_generator.py to generate a secure random key
SECRET_KEY=put_your_generated_secret_key_here

# Admin password for seeding
ADMIN_PASSWORD=Put_your_admin_password1!

# Frontend base URL. Leave the url as is for local development.
FRONTEND_BASE_URL=http://localhost:5173

# For PostgreSQL connection, leave the username, password, and database name as is for local development
DB_USER=db_username
DB_PASSWORD=db_password
DB_NAME=tool_share_db

# MinIO
MINIO_ROOT_USER=admin_operator
MINIO_ROOT_PASSWORD=super_secure_password_123
MINIO_BUCKET_NAME=community-tool-share-media
STORAGE_INTERNAL_ENDPOINT=http://minio:9000
STORAGE_EXTERNAL_ENDPOINT=http://localhost:9000

# Availability calendar
APP_TIMEZONE_NAME="Pacific/Honolulu"

# Email 
# To send links on email get api key on resend.com
# Conncet domain (need to buy one)
# Insert key and sender email to corresponding variables

# * OR leave the variables as it if you want to get links in dev console

# ** OR if you add only RESEND_API_KEY and omit SENDER_EMAIL it works.
# ** But you will manage to send links only on your email you register on resend.com with (or on the test one: delivered@resend.dev).
RESEND_API_KEY=
SENDER_EMAIL=